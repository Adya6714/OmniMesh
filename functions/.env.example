# Copy to functions/.env for local emulator testing.
# For deployed Functions v2, use Firebase Secret Manager instead of committing keys:
#   firebase functions:secrets:set GEMINI_API_KEY
# Then bind the secret in code / console per Firebase docs.

GEMINI_API_KEY=

# Optional override (default in code: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
