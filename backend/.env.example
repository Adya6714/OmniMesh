# ---- Cloud inference: Fireworks AI (models hosted on AMD hardware) ----
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
TRIAGE_MODEL=accounts/fireworks/models/gemma-3-27b-it
TRANSLATION_MODEL=accounts/fireworks/models/gemma-3-27b-it
VISION_MODEL=accounts/fireworks/models/qwen2p5-vl-32b-instruct
RECONCILE_MODEL=accounts/fireworks/models/gemma-3-27b-it
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# ---- Local inference: Gemma on AMD GPU via vLLM-ROCm ----
# Leave blank to run without a GPU (falls back to heuristic + Fireworks).
# On the AMD Developer Cloud instance with the vllm-rocm service running:
LOCAL_MODEL_URL=
LOCAL_MODEL_ID=google/gemma-2-2b-it
LOCAL_MODEL_KEY=
