// Copy to firestore.rules and deploy with Firebase CLI when you add rules to firebase.json.
// Enable Anonymous Authentication in Firebase Console before relying on request.auth != null.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /packets/{packetId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['urgency', 'injury', 'lat', 'lon'])
        && request.resource.data.urgency in ['RED', 'YELLOW', 'GREEN', 'BLACK'];
      allow update, delete: if request.auth != null;
    }

    match /dispatch_analysis/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
