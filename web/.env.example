# Firebase (required for Firestore — baked in at build time)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Gemini dispatch agent (existing cloud path)
REACT_APP_GEMINI_API_KEY=
REACT_APP_GEMINI_MODEL=gemini-2.5-flash

# OmniMesh AI backend — FastAPI service (Gemma via Fireworks / optional ROCm)
REACT_APP_BACKEND_URL=http://localhost:8000
